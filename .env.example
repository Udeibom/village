# Copy this file to .env and fill in your key. .env is ignored by git.
GROQ_API_KEY=your_key_here

# Optional. The Groq-hosted model that writes the lessons. The default is
# openai/gpt-oss-120b; change it if Groq's catalogue shifts again.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Port for the local middleman server.
PORT=3001
